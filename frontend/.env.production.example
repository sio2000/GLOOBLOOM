# Netlify → Site settings → Environment variables
# Replace with your Render backend URL after deploying the API

NEXT_PUBLIC_API_URL=https://gloobloom-api.onrender.com
NEXT_PUBLIC_WS_URL=https://gloobloom-api.onrender.com
# Must match backend ADMIN_SECRET (in-game dev tools / ?admin= URL)
NEXT_PUBLIC_ADMIN_SECRET=change-me-in-production

# Admin dashboard (/admin) uses ADMIN_PANEL_PASSWORD on the backend only — do NOT put it here.
