DATABASE_URL="file:./prisma/dev.db"
PORT=4000
FRONTEND_URL=http://localhost:3000
# Production: comma-separated Netlify URLs, e.g. https://gloobloom.netlify.app,https://your-domain.com
ADMIN_SECRET=gloobloom-admin-secret-change-me
# Dashboard login at /admin — set a strong password (never commit real values)
ADMIN_PANEL_PASSWORD=change-me-strong-password
NODE_ENV=development
DECAY_INTERVAL_MS=60000
HYDRATION_LOSS_PER_MINUTE=0.5
GROWTH_PER_WATERING=2.5

# Stripe (production). For local dev without payments: STRIPE_SKIP_PAYMENTS=true
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SKIP_PAYMENTS=true
