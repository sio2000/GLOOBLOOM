# Production backend (Render / Railway / VPS)
# FRONTEND_URL: comma-separated Netlify URLs (production + optional preview)
# Example: https://gloobloom.netlify.app,https://deploy-preview-123--gloobloom.netlify.app

DATABASE_URL="file:./prisma/prod.db"
PORT=4000
FRONTEND_URL=https://your-site.netlify.app
ADMIN_SECRET=change-me-in-production
NODE_ENV=production
DECAY_INTERVAL_MS=60000
HYDRATION_LOSS_PER_MINUTE=0.5
GROWTH_PER_WATERING=2.5
